# Supabase Postgres connection strings
# DATABASE_URL: pooled connection (used by the app at runtime)
# DIRECT_URL: direct connection (used by Prisma for schema push/migrations)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=12"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"


